# Local-only development switch. Set false to suppress the browser widget and
# CAPTCHA token handling. This is ignored by production builds.
TURNSTILE_ENABLED=true

# Production is protected by default. Only set this separate variable to false
# through an intentional production configuration change.
TURNSTILE_PRODUCTION_ENABLED=true

# Public Cloudflare Turnstile site key. Leave blank until the widget is ready
# to roll out; do not enable Supabase CAPTCHA protection until it is deployed.
VITE_TURNSTILE_SITE_KEY=
